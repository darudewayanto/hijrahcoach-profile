---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Img from "../components/Img.astro";
import Icon from "../components/Icon.astro";
import { u } from "../lib/url";
import { photo, brand } from "../lib/assets";
import { wa, abcBenefits, abcTotal, abcInvestment, abcSteps, abcFaq, certifications } from "../data/site";
---
<Base title="Associate Business Coach Program" description="Associate Business Coach (ABC) Program Hijrah Coach: 16 benefit senilai Rp285,5 juta, termasuk 5 sertifikasi internasional (ICF, ICAgile, MyBrain), mentoring Master Coach, dan support bisnis coaching. Investasi Rp40 juta.">
  <PageHero
    eyebrow="Associate Business Coach Program"
    title="Jadilah<br/>Professional<br/>Business Coach"
    lead="Program yang tidak hanya membangun kompetensi Anda, tapi juga kemampuan mewujudkan mimpi menjadi Master Coach dan entrepreneur sukses dengan bisnis & firma coaching sendiri."
    img="class-blue"
    imgAlt="Coach Daru mengajar kelas sertifikasi"
  >
    <a class="btn btn-ink" href={wa("abc")} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /> Daftar ABC</a>
    <a class="btn btn-line" href="#benefit">Lihat 16 benefit</a>
  </PageHero>

  <!-- Value summary -->
  <section class="section-sm">
    <div class="wrap">
      <div class="summary">
        <div class="sum-badge">
          <Img src={brand.abcp} alt="Agile Certified Hijrah Coach — ICAgile, ICF, MyBrain" width={150} />
        </div>
        <div><span class="caps">Total benefit</span><b>{abcTotal}</b></div>
        <div><span class="caps">Investasi ABC</span><b class="gold-d">{abcInvestment}</b></div>
        <div><span class="caps">Sertifikasi</span><b>5</b><small>ICAgile · ICF · MyBrain · Hijrah</small></div>
        <a class="btn btn-ink" href={wa("abc")} target="_blank" rel="noopener">Ambil kursi <Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Benefit table -->
  <section class="section" id="benefit">
    <div class="wrap">
      <div class="head split">
        <div>
          <span class="eyebrow">Benefit of Associate Business Coach</span>
          <h2 class="h-lg" style="margin-top:1rem">16 Benefit,<br />1 Investasi</h2>
        </div>
        <p class="lead">Bandingkan yang Anda dapatkan sebagai <b>Certification Graduate</b> dan sebagai <b>Associate Business Coach</b>. Sembilan benefit terakhir tidak bisa dinilai dengan uang: sistem, tim, dan brand yang sudah terbukti 10 tahun.</p>
      </div>

      <div class="tbl" role="region" aria-label="Tabel benefit Associate Business Coach" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col" class="n">No.</th>
              <th scope="col">Benefit</th>
              <th scope="col" class="v">Value</th>
              <th scope="col" class="c">Certification<br />Graduate</th>
              <th scope="col" class="c abc">Associate<br />Business Coach</th>
            </tr>
          </thead>
          <tbody>
            {abcBenefits.map((b, i) => (
              <tr>
                <td class="n">{String(i + 1).padStart(2, "0")}</td>
                <td><b>{b.title}</b><span class="note">{b.note}</span></td>
                <td class="v">{b.value ?? <span class="priceless">Priceless value</span>}</td>
                <td class="c">{b.grad ? <Icon name="check" size={20} /> : <span class="dash" aria-label="Tidak termasuk">—</span>}</td>
                <td class="c abc"><Icon name="check" size={20} /></td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="total"><td></td><th scope="row">Total benefit</th><td class="v">{abcTotal}</td><td colspan="2"></td></tr>
            <tr class="invest"><td></td><th scope="row">Investasi Associate Business Coach Program</th><td class="v">{abcInvestment}</td><td colspan="2" class="c"><a class="btn btn-gold btn-sm" href={wa("abc")} target="_blank" rel="noopener">Daftar <Icon name="arrow-right" size={13} /></a></td></tr>
          </tfoot>
        </table>
      </div>
      <p class="fine">Sertifikasi diikuti sesuai term of payment. Benefit no. 13–16 berlaku sesuai akad ABC.</p>
    </div>
  </section>

  <!-- Certifications included -->
  <section class="section bg-paper">
    <div class="wrap">
      <div class="head split">
        <div>
          <span class="eyebrow">Termasuk dalam ABC</span>
          <h2 class="h-lg" style="margin-top:1rem">5 Bundling<br />Certification</h2>
        </div>
        <p class="lead">Satu-satunya di Asia & Australia: program agile coaching terakreditasi dari 3 organisasi besar dunia, ICAgile, ICF, dan MyBrain, ditambah 2 sertifikasi bisnis rancangan Hijrah Coach.</p>
      </div>
      <ol class="cert-list">
        {certifications.map((c) => (
          <li>
            <span class="code">{c.code}</span>
            <div>
              <h3>{c.name}</h3>
              <p class="muted">{c.credential}</p>
            </div>
            <span class="meta"><Icon name="clock" size={15} /> {c.hours}</span>
            <span class="meta"><Icon name={c.mode === "Online" ? "globe" : "pin"} size={15} /> {c.mode}</span>
          </li>
        ))}
      </ol>
      <a class="link-arrow" href={u("/sertifikasi")}>Detail setiap sertifikasi <Icon name="arrow-right" size={14} /></a>
    </div>
  </section>

  <!-- Roadmap -->
  <section class="section bg-ink on-dark">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">A structured roadmap as a Master Coach</span>
        <h2 class="h-lg">Dari Bronze<br />sampai Gold</h2>
        <p class="lead">Setiap level berlangsung 3 bulan dalam 3 jalur kompetensi, dibangun di atas fondasi Agile–Lean Practitioner: mindset, value & principle.</p>
      </div>
      <!-- Roadmap artwork from Coach Daru, shown as-is on the dark section (transparent background, empty margins trimmed). -->
      <div class="road-art">
        <Img src={photo["roadmap"]} alt="Roadmap kompetensi: Coaching, Mentoring & Facilitating, MyBrain Practitioner, dan Training & Instructor, masing-masing 3 bulan Bronze, Silver, Gold Master Class menuju Master Hijrah Coach. Fully accredited by ICF, ICAgile, MyBrain" widths={[900, 1400]} sizes="(min-width: 1240px) 1160px, 100vw" />
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="section">
    <div class="wrap steps-grid">
      <div class="steps-photo">
        <Img src={photo["mou"]} alt="Penandatanganan kerja sama di acara Agile Hijrah Coaching" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 45vw, 100vw" class="mono" />
      </div>
      <div>
        <span class="eyebrow">Cara bergabung</span>
        <h2 class="h-lg" style="margin:1rem 0 2rem">4 Langkah<br />Menjadi ABC</h2>
        <ol class="steps">
          {abcSteps.map((s, i) => (
            <li><span class="num">{i + 1}</span><div><h3>{s.title}</h3><p class="muted">{s.text}</p></div></li>
          ))}
        </ol>
        <a class="btn btn-ink" href={wa("abc")} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /> Mulai konsultasi</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-sm bg-paper">
    <div class="wrap faq-wrap">
      <h2 class="h-md">Pertanyaan<br />yang sering diajukan</h2>
      <div class="faq">
        {abcFaq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}<Icon name="plus" size={18} /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

</Base>

<style>
  .summary {
    display: grid; gap: 1.2rem; align-items: center;
    padding: 1.4rem clamp(1.2rem, 3vw, 2rem); border-radius: 18px; background: var(--ink); color: #fff;
  }
  .summary div { display: grid; gap: 0.15rem; }
  .summary .caps { font-size: 0.64rem; color: rgba(255, 255, 255, 0.55); }
  .summary b { font-family: var(--serif); font-size: clamp(1.6rem, 2.8vw, 2.2rem); line-height: 1.05; }
  .summary small { font-size: 0.74rem; color: rgba(255, 255, 255, 0.6); }
  .gold-d { color: var(--gold-2); }
  .sum-badge :global(img) { width: 96px; height: auto; }
  .summary .btn { justify-self: start; }
  @media (min-width: 900px) { .summary { grid-template-columns: auto 1fr 1fr 1fr auto; gap: 2rem; } .summary div + div { border-left: 1px solid var(--line-dark); padding-left: 2rem; } }

  .tbl { overflow-x: auto; border-radius: 16px; border: 1px solid var(--line); background: var(--paper); }
  table { min-width: 760px; font-size: 0.9rem; }
  thead th { background: var(--ink); color: #fff; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; padding: 1rem; text-align: left; line-height: 1.35; }
  thead th.abc { background: var(--gold-deep); }
  td, tfoot th { padding: 0.95rem 1rem; border-top: 1px solid var(--line); vertical-align: top; }
  td b { display: block; font-weight: 700; line-height: 1.35; }
  .note { display: block; margin-top: 0.3rem; font-size: 0.8rem; color: var(--ink-soft); line-height: 1.45; }
  .n { width: 54px; color: var(--grey); font-weight: 700; font-variant-numeric: tabular-nums; }
  .v { width: 150px; text-align: right; font-family: var(--serif); font-weight: 700; font-size: 1.02rem; white-space: nowrap; }
  .c { width: 130px; text-align: center; }
  thead .v { text-align: right; }
  thead .c { text-align: center; }
  td.c :global(svg) { margin-inline: auto; color: var(--ink); }
  td.abc { background: rgba(187, 149, 110, 0.1); }
  td.abc :global(svg) { color: var(--gold-deep); }
  .dash { color: var(--stone); }
  .priceless { font-family: var(--sans); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold-deep); }
  tbody tr:hover td { background: rgba(21, 20, 19, 0.025); }
  tfoot th { text-align: left; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  tfoot .total td, tfoot .total th { background: var(--cream-2); }
  tfoot .invest td, tfoot .invest th { background: var(--ink); color: #fff; }
  tfoot .invest .v { color: var(--gold-2); font-size: 1.4rem; }
  .fine { margin-top: 1rem; font-size: 0.8rem; color: var(--grey); }

  .cert-list { display: grid; border-top: 1px solid var(--line); margin-bottom: 2rem; }
  .cert-list li { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem 1.2rem; align-items: center; padding: 1.2rem 0; border-bottom: 1px solid var(--line); }
  .code { grid-row: span 2; font-family: var(--serif); font-weight: 800; font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--gold-deep); min-width: 4.5ch; }
  .cert-list h3 { font-size: 1.3rem; }
  .cert-list p { font-size: 0.86rem; }
  .meta { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; font-weight: 700; color: var(--ink-soft); }
  @media (min-width: 800px) { .cert-list li { grid-template-columns: 6rem 1fr 9rem 7rem; } .code { grid-row: auto; } }

  .road-art { margin-top: 0.5rem; }
  .road-art :global(img) { width: 100%; height: auto; }

  .steps-grid { display: grid; gap: 3rem; align-items: center; }
  .steps-photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 18px; }
  .steps { display: grid; gap: 1.4rem; margin-bottom: 2rem; }
  .steps li { display: flex; gap: 1.1rem; }
  .num { flex: none; width: 42px; height: 42px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--gold-deep); color: var(--gold-deep); font-family: var(--serif); font-weight: 800; font-size: 1.2rem; }
  .steps h3 { font-size: 1.3rem; margin-bottom: 0.3rem; }
  .steps p { font-size: 0.92rem; }
  @media (min-width: 900px) { .steps-grid { grid-template-columns: 0.9fr 1.1fr; gap: 5rem; } }

  .faq-wrap { display: grid; gap: 2rem; }
  .faq details { border-bottom: 1px solid var(--line); padding: 1.1rem 0; }
  .faq summary { display: flex; justify-content: space-between; gap: 1rem; cursor: pointer; list-style: none; font-family: var(--serif); font-weight: 700; font-size: 1.2rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary :global(svg) { flex: none; transition: transform 0.3s var(--ease); }
  .faq details[open] summary :global(svg) { transform: rotate(45deg); }
  .faq p { margin-top: 0.7rem; color: var(--ink-soft); max-width: 70ch; }
  @media (min-width: 900px) { .faq-wrap { grid-template-columns: 0.8fr 1.2fr; gap: 4rem; } }
</style>
