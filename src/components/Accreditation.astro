---
import Img from "./Img.astro";
import { accredImg } from "../lib/assets";
import { accreditations, awards } from "../data/site";
---
<section class="section-sm bg-paper acc">
  <div class="wrap">
    <div class="head center">
      <span class="eyebrow">Kredibilitas internasional</span>
      <h2 class="h-md">Terakreditasi 6 organisasi coaching &<br class="br" /> applied-neuroscience dunia</h2>
    </div>
    <ul class="logos">
      {accreditations.map((a) => (
        <li title={`${a.name} · ${a.origin}`}>
          <Img src={accredImg[a.logo]} alt={`${a.name} (${a.origin})`} height={56} />
          <span>{a.origin}</span>
        </li>
      ))}
    </ul>
    <ul class="awards">
      {awards.map((a) => <li>{a}</li>)}
    </ul>
  </div>
</section>

<style>
  .logos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .logos li { display: grid; justify-items: center; align-content: center; gap: 0.7rem; padding: 1.6rem 1rem; background: var(--paper); text-align: center; }
  .logos :global(img) { height: 56px; width: auto; max-width: 150px; object-fit: contain; filter: grayscale(1) contrast(1.1); opacity: 0.85; transition: filter 0.4s, opacity 0.4s; }
  .logos li:hover :global(img) { filter: none; opacity: 1; }
  .logos span { font-size: 0.72rem; color: var(--grey); line-height: 1.35; }
  .awards { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; margin-top: 1.8rem; }
  .awards li { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.5rem 0.9rem; border: 1px solid rgba(150, 115, 79, 0.4); border-radius: 999px; color: var(--gold-deep); }
  @media (min-width: 720px) { .logos { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1100px) { .logos { grid-template-columns: repeat(6, 1fr); } }
  @media (max-width: 700px) { .br { display: none; } }
</style>
