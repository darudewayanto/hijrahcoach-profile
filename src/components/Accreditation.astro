---
import Img from "./Img.astro";
import { photo } from "../lib/assets";
import { awards } from "../data/site";
---
<section class="section-sm bg-paper acc">
  <div class="wrap">
    <div class="head center">
      <h2 class="acc-title"><span>Di Akreditasi oleh 3 World Major Coaching Organization dan</span> <span>Pemegang 3 Internationally Accredited Coaching Certification</span></h2>
    </div>
    <!-- Badge artwork from Coach Daru (Accredited Program + Master Credential), kept as lossless PNG. -->
    <div class="strip">
      <Img src={photo["accred-program"]} alt="Accredited Program: ICF Level 1, ICP-ACC, MiND Practitioner Certification" widths={[481]} sizes="(min-width: 960px) 430px, 100vw" format="png" />
      <Img src={photo["accred-master"]} alt="Master Credential: Master Certified Coach, ICE-AC, MyBrain Master Practitioner" widths={[483]} sizes="(min-width: 960px) 430px, 100vw" format="png" />
    </div>
    <ul class="awards">
      {awards.map((a) => <li>{a}</li>)}
    </ul>
  </div>
</section>

<style>
  /* Two fixed lines on desktop; wraps naturally on small screens. */
  .acc-title { font-size: clamp(1.35rem, 2.15vw, 1.95rem); line-height: 1.25; }
  @media (min-width: 900px) { .acc-title span { display: block; white-space: nowrap; } }
  /* The two badge rows sit side by side on desktop and stack on small screens, never wider than their 480px source. */
  .strip { display: grid; grid-template-columns: 1fr; justify-items: center; gap: 1.5rem; padding-top: 0.5rem; max-width: 900px; margin-inline: auto; }
  @media (min-width: 760px) { .strip { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }
  .strip :global(img) { width: 100%; max-width: 430px; height: auto; }
  .awards { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; margin-top: 1.8rem; }
  .awards li { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.5rem 0.9rem; border: 1px solid rgba(150, 115, 79, 0.4); border-radius: 999px; color: var(--gold-deep); }
</style>
