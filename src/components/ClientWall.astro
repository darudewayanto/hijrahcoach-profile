---
import Img from "./Img.astro";
import { clientImg } from "../lib/assets";
import { clients } from "../data/site";

// Give every logo the same visual area (not the same height), so wide wordmarks and
// square emblems read at a similar weight. Clamped so extremes stay reasonable.
const AREA = 4200;
const size = (c: string) => {
  const { width: w, height: h } = clientImg[c];
  const r = w / h;
  let lh = Math.sqrt(AREA / r);
  lh = Math.min(lh, 60);
  if (lh * r > 120) lh = 120 / r;
  return { width: Math.round(lh * r), height: Math.round(lh) };
};
---
<section class="section-sm">
  <div class="wrap">
    <div class="head center">
      <h2 class="h-lg">Kementerian, BUMN &<br />Perusahaan Global</h2>
    </div>
    <ul class="wall">
      {clients.filter((c) => clientImg[c]).map((c) => (
        <li><Img src={clientImg[c]} alt={c.replace(/-/g, " ")} {...size(c)} /></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .wall { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem 1rem; align-items: center; }
  .wall li { display: grid; place-items: center; height: 76px; }
  .wall :global(img) { max-width: 100%; height: auto; object-fit: contain; filter: grayscale(1) contrast(0.9); opacity: 0.62; mix-blend-mode: multiply; transition: filter 0.4s, opacity 0.4s; }
  .wall li:hover :global(img) { filter: none; opacity: 1; }
  @media (min-width: 720px) { .wall { grid-template-columns: repeat(5, 1fr); } }
  @media (min-width: 1100px) { .wall { grid-template-columns: repeat(9, 1fr); } }
</style>
